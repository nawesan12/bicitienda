# ── Variables de entorno de la tienda ───────────────────────────
# Copiá este archivo a .env.local y completá. En Vercel se cargan en
# Project Settings → Environment Variables (Production y Preview).
#
# Regla de la casa: TODO funciona en local sin estas variables (modo
# simulado); cada integración pasa a modo real solo con setear su env.
# Las que están comentadas NO pueden quedar vacías (una cadena vacía no
# cae al default): descomentalas recién al completarlas.
# No hay Auth.js (AUTH_SECRET), Vercel Blob ni Mercado Pago por defecto.

# ── Sitio ────────────────────────────────────────────────────────
# URL pública con https y sin barra final: canonicals, sitemap, OG,
# links de los emails y las URLs de retorno y notificación de la
# pasarela (Payway la necesita para avisar los pagos). Ej:
# https://mitienda.com.ar
# NEXT_PUBLIC_SITE_URL=
# Solo desarrollo, sin NEXT_PUBLIC_SITE_URL: origin de los links de los
# mails, WhatsApp y retornos de la pasarela (default http://localhost:3100).
# En producción se ignora: sin NEXT_PUBLIC_SITE_URL va store.siteUrl.
# DEV_SITE_URL=

# ── Cron diario (Vercel Cron) ────────────────────────────────────
# vercel.json agenda GET /api/cron/diario una vez por día (Hobby permite
# 1 cron diario): vence las reservas sin pago (expireStaleOrders). Vercel
# manda "Authorization: Bearer <CRON_SECRET>" solo si la variable existe
# en el proyecto. String largo aleatorio (`openssl rand -hex 24`).
# SIN la variable el endpoint responde 401 en producción (en dev se puede
# llamar sin header).
CRON_SECRET=

# ── Base de datos: Neon Postgres ─────────────────────────────────
# Se crea desde el Marketplace de Vercel (Storage → Neon), que inyecta
# DATABASE_URL sola en el proyecto. SIN esta variable, dev y los scripts
# usan PGlite embebido en .data/pglite.
#   pnpm db:migrate && pnpm db:seed   (con DATABASE_URL apuntando a Neon)
DATABASE_URL=

# ── Acceso al admin (PIN único) ──────────────────────────────────
# Generar las dos con:  pnpm admin:pin   (pide el PIN sin eco, ≥ 6 dígitos)
# ADMIN_PIN_HASH: scrypt "salt:hash" en hex. SIN hash: en desarrollo se
#   acepta el PIN 000000 (con warning); en producción el login falla.
# ADMIN_SESSION_SECRET: firma HMAC de la cookie de sesión (7 días).
#   Cambiarlo cierra todas las sesiones abiertas.
ADMIN_PIN_HASH=
ADMIN_SESSION_SECRET=

# ── Imágenes: Cloudinary ─────────────────────────────────────────
# Dashboard de Cloudinary → API Keys → "API environment variable".
# Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
# SIN esta variable: las fotos del admin van a .data/uploads/ (servidas
# por /uploads/) y las del seed salen de public/.
# CON la variable: `pnpm seed:images` sube fotos del seed y logos a la
# carpeta <store.slug>/ (lib/config.ts) y escribe lib/data/image-manifest.json
# (commitearlo); después `pnpm db:seed` guarda esas URLs en la base.
# PDF del catálogo: solo con `pnpm seed:images --pdf`, y antes hay que
# activar en Cloudinary → Settings → Security "Allow delivery of PDF and
# ZIP files" (las cuentas free lo bloquean con 401). Sin eso el PDF se
# sirve estático desde public/brand/.
CLOUDINARY_URL=

# ── Pagos: Payway (formulario de pago hosteado) ──────────────────
# Credenciales del comercio en Payway (ex Decidir): número de site y las
# API keys pública y privada del ambiente que corresponda.
# SIN keys: el checkout usa el sandbox local /checkout/pago-simulado.
# PAYWAY_ENV: "sandbox" (developers.decidir.com, default si queda vacío)
#   o "production" (ventasonline.payway.com.ar).
# PAYWAY_WEBHOOK_TOKEN: token propio (string largo aleatorio, p. ej.
#   `openssl rand -hex 24`) que viaja en la notifications_url
#   <NEXT_PUBLIC_SITE_URL>/api/payway/webhook?t=<token>. Obligatorio en
#   producción.
PAYWAY_ENV=
PAYWAY_SITE_ID=
PAYWAY_PUBLIC_KEY=
PAYWAY_PRIVATE_KEY=
PAYWAY_WEBHOOK_TOKEN=

# ── Pagos: Mercado Pago (opcional, apagado por defecto) ──────────
# Solo se usa si features.payments.mp = true en lib/config.ts.
# Credenciales en https://www.mercadopago.com.ar/developers → Tus
# integraciones. Webhook: <NEXT_PUBLIC_SITE_URL>/api/mp/webhook (evento
# "Pagos"), clave secreta de firma en MP_WEBHOOK_SECRET.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ── Instagram (feed de la home) ──────────────────────────────────
# Instagram API with Instagram Login. Lo normal es conectar la cuenta
# desde Admin → Ajustes → "Conectar Instagram" (OAuth): el token largo
# (60 días) y el id de la cuenta se guardan en la base y se renuevan
# solos. Para eso hacen falta los datos de la app de Meta (panel de la
# app → Instagram → API setup with Instagram business login):
# IG_APP_ID / IG_APP_SECRET: "Instagram app ID" y "Instagram app secret".
# IG_REDIRECT_URI: EXACTAMENTE la cargada en "OAuth redirect URIs":
#   <NEXT_PUBLIC_SITE_URL>/api/auth/instagram/callback
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=
# Legado / fallback: id de la cuenta profesional y un token largo pegados
# a mano. Se usan solo si no hay una cuenta conectada desde el admin.
# SIN nada de esto: los placeholders.
# IG_USER_ID=
# IG_TOKEN=

# ── Emails: Resend ───────────────────────────────────────────────
# SIN key: los emails quedan en .data/outbox/*.html (modo simulado).
# MAIL_FROM: remitente del dominio verificado en Resend, ej.
#   Mi Tienda <pedidos@mitienda.com.ar>
RESEND_API_KEY=
# MAIL_FROM=
